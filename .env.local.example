# Copy this file to .env.local and fill in real values.
# .env.local is gitignored and never committed.

# Supabase project settings -> API
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key

# Admin panel (/admin) login
ADMIN_PASSWORD=choose-a-strong-password
# Random long random string used to sign the admin session cookie.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SESSION_SECRET=replace-with-a-random-64-char-hex-string

# Razorpay (dashboard.razorpay.com -> Settings -> API Keys).
# Use Test Mode keys while developing — no real charges happen.
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_key_secret
# Settings -> Webhooks -> Add New Webhook, pointing at
# <NEXT_PUBLIC_APP_URL>/api/payments/razorpay/webhook, subscribed to the
# "payment.captured" event. Paste the secret you set there below.
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret

# The public URL this app is reachable at — needed so the Razorpay webhook
# above has a real reachable URL, not localhost, once you're testing an
# actual payment.
NEXT_PUBLIC_APP_URL=http://localhost:3000
