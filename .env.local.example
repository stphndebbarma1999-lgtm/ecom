# Copy this file to .env.local and fill in real values.
# .env.local is gitignored and never committed.

# Supabase project settings -> API
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key

# Admin panel (/admin) login
ADMIN_PASSWORD=choose-a-strong-password
# Random long random string used to sign the admin session cookie.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SESSION_SECRET=replace-with-a-random-64-char-hex-string

# Paytm Business (dashboard.paytm.com -> Developer Settings -> API Keys).
# Use the Staging/Test credentials while developing — no real charges happen.
PAYTM_MID=your_test_mid
PAYTM_MERCHANT_KEY=your_test_merchant_key
# "WEBSTAGING" for test mode; your registered website name once you switch
# PAYTM_ENVIRONMENT to "production" with live keys.
PAYTM_WEBSITE=WEBSTAGING
PAYTM_ENVIRONMENT=staging

# The public URL this app is reachable at — Paytm calls back to
# <this>/api/payments/paytm/callback after payment, so it must be a real
# reachable URL, not localhost, once you're testing an actual payment.
NEXT_PUBLIC_APP_URL=http://localhost:3000
